# ============================================================
# Mutable runtime state  (lives in %LOCALAPPDATA%\ticktick-integration, never here)
# ============================================================
# Belt and braces: the sync writes these into the data directory by design,
# because a plugin update replaces the plugin folder wholesale. A stray copy
# in the working tree means somebody ran with TICKTICK_INTEGRATION_DATA pointed here
# -- their token and their task-id map must still not reach a commit.
.env
state.json
sync.log
sync.lock

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
.pytest_cache/

# ============================================================
# Claude Code
# ============================================================
# Local, uncommitted overrides -- .claude/settings.json IS shared.
.claude/settings.local.json

# Agent working notes from the build sessions: plans, diffs and per-task
# reports. Useful while a session runs, noise in the history afterwards.
.superpowers/
